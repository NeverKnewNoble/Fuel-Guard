# FuelGuard environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# ------------------------------------------------------------------ Database
# Neon Postgres connection string (Neon dashboard → Connection details).
# Used by the app (src/db/index.ts), drizzle-kit, and the seed script.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# ---------------------------------------------------------------------- Auth
# Encrypts the session cookie. Generate one with:
#   openssl rand -base64 33
# Changing it signs everyone out.
AUTH_SECRET=""

# Only needed when self-hosting with `next start` (not on Vercel, not `next dev`).
# Without one of these, sign-in fails with "UntrustedHost".
# AUTH_TRUST_HOST=true
# AUTH_URL="https://fuelguard.example.com"

# ---------------------------------------------------------------------- Seed
# Password given to the demo accounts created by `yarn db:seed`
# (at least 8 characters). Only read by src/db/seed.ts; can be set inline instead:
#   SEED_PASSWORD='your-password' yarn db:seed
# SEED_PASSWORD=""
